FUNCTION_BLOCK "FB_PumpControl"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Enable : Bool;
      AutoRequest : Bool;
      FaultOK : Bool;
      RunFeedback : Bool;
      SourceOK : Bool;
      EStopOK : Bool;
      RestartDelay : Time;
      Clock1Hz : Bool;
   END_VAR

   VAR_OUTPUT 
      RunCommand : Bool;
      Available : Bool;
      StartEvent : Bool;
      StopEvent : Bool;
      Runtime_s : UDInt;
      StartCount : UDInt;
   END_VAR

   VAR 
      tRestart : TOF_TIME;
      rStart : R_TRIG;
      fStop : F_TRIG;
      r1s : R_TRIG;
   END_VAR

BEGIN
	// Pump available when enabled and the fault input is healthy (NC contact).
	// Low flow and feedback timeout are added in Missions 7 and 8.
	#Available := #Enable AND #FaultOK;

	// Anti-restart delay (IL-07): TOF output stays TRUE during RestartDelay after a stop.
	#tRestart(IN := #RunCommand, PT := #RestartDelay);

	// Run command: request, interlocks and restart delay satisfied.
	IF #Available AND #AutoRequest AND #SourceOK AND #EStopOK AND (#RunCommand OR NOT #tRestart.Q) THEN
	    #RunCommand := TRUE;
	ELSE
	    #RunCommand := FALSE;
	END_IF;

	// Start and stop events on edges of the run command .
	#rStart(CLK := #RunCommand);
	#fStop(CLK := #RunCommand);
	#StartEvent := #rStart.Q;
	#StopEvent := #fStop.Q;
	IF #StartEvent THEN
	    #StartCount := #StartCount + 1;
	END_IF;

	// Runtime in seconds
	#r1s(CLK := #Clock1Hz);
	IF #r1s.Q AND #RunFeedback THEN
	    #Runtime_s := #Runtime_s + 1;
	END_IF;
END_FUNCTION_BLOCK