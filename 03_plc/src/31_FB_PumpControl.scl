FUNCTION_BLOCK "FB_PumpControl"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Enable : Bool;
      AutoRequest : Bool;
      ManualRequest : Bool;
      TestRequest : Bool;
      FaultOK : Bool;
      RunFeedback : Bool;
      SourceOK : Bool;
      EStopOK : Bool;
      OtherRunning : Bool;
      RestartDelay : Time;
      TestMax : Time;
      Clock1Hz : Bool;
   END_VAR

   VAR_OUTPUT 
      RunCommand : Bool;
      Available : Bool;
      RestartDone : Bool;
      StartEvent : Bool;
      StopEvent : Bool;
      Runtime_s : UDInt;
      StartCount : UDInt;
   END_VAR

   VAR 
      tRestart : TOF_TIME;
      tTest : TON_TIME;
      rStart : R_TRIG;
      fStop : F_TRIG;
      r1s : R_TRIG;
   END_VAR

   VAR_TEMP 
      request : Bool;
   END_VAR

BEGIN
    #Available := #Enable AND #FaultOK;

    // A maintenance test stops after TestMax and needs a new command to run again.
    #tTest(IN := #TestRequest, PT := #TestMax);
    #request := #AutoRequest OR #ManualRequest OR (#TestRequest AND NOT #tTest.Q);

    // The off-delay output stays TRUE during the restart delay after a stop.
    #tRestart(IN := #RunCommand, PT := #RestartDelay);
    #RestartDone := NOT #tRestart.Q;

    IF #Available AND #request AND #SourceOK AND #EStopOK AND NOT #OtherRunning
       AND (#RunCommand OR NOT #tRestart.Q) THEN
        #RunCommand := TRUE;
    ELSE
        #RunCommand := FALSE;
    END_IF;

    // Count starts on the edge of the command, not on every scan.
    #rStart(CLK := #RunCommand);
    #fStop(CLK := #RunCommand);
    #StartEvent := #rStart.Q;
    #StopEvent := #fStop.Q;
    IF #StartEvent THEN
        #StartCount := #StartCount + 1;
    END_IF;

    #r1s(CLK := #Clock1Hz);
    IF #r1s.Q AND #RunFeedback THEN
        #Runtime_s := #Runtime_s + 1;
    END_IF;
END_FUNCTION_BLOCK