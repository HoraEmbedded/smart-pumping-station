ORGANIZATION_BLOCK "Main"
TITLE = "Main Program Sweep (Cycle)"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

BEGIN
	"FC_ReadAndScaleInputs"();
	"FC_Interlocks"();
	"FC_AlarmLatch"();
	
	"DB_ModeManager"(StartReq := "DI_Start_System",
	                 StopReq := "DI_Stop_System",
	                 CriticalFault := "DB_Alarms".CriticalActive,
	                 SelAuto := "DI_Mode_Auto",
	                 SelManual := "DI_Mode_Manual",
	                 SelMaint := "DI_Mode_Maintenance",
	                 InitDelay := "DB_Parameters".Init_Delay,
	                 State => "DB_StationState".StationState);
	
	"DB_AutoCycle"(Active := ("DB_StationState".StationState = 30),
	               Level := "DB_Process".TankLevel_pct,
	               LevelValid := "DB_Process".TankLevel_Valid,
	               LevelLow := "DB_Parameters".Level_Low,
	               LevelHigh := "DB_Parameters".Level_High,
	               P1Available := "DB_Pump1".Available,
	               P2Available := "DB_Pump2".Available,
	               P1RestartDone := "DB_Pump1".RestartDone,
	               P2RestartDone := "DB_Pump2".RestartDone,
	               P1RunFeedback := "DB_Process".P1_RunFeedback,
	               P2RunFeedback := "DB_Process".P2_RunFeedback);
	"DB_StationState".PumpingDemand := "DB_AutoCycle".Demand;
	
	"DB_Pump1"(Enable := ("DB_StationState".StationState >= 20) AND ("DB_StationState".StationState <= 50),
	           AutoRequest := "DB_AutoCycle".P1Request,
	           ManualRequest := ("DB_StationState".StationState = 40) AND "DB_HMI".P1_PumpCmd,
	           TestRequest := ("DB_StationState".StationState = 50) AND "DB_HMI".P1_PumpCmd,
	           FaultOK := NOT "DB_Alarms".P1FaultLatched,
	           RunFeedback := "DB_Process".P1_RunFeedback,
	           SourceOK := "DB_StationState".SourceOK,
	           EStopOK := "DB_StationState".EStopOK,
	           OtherRunning := "DB_Pump2".RunCommand,
	           RestartDelay := "DB_Parameters".Restart_Delay,
	           TestMax := "DB_Parameters".Maint_Test_Max,
	           Clock1Hz := "Clock_1Hz");
	
	"DB_Pump2"(Enable := ("DB_StationState".StationState >= 20) AND ("DB_StationState".StationState <= 50),
	           AutoRequest := "DB_AutoCycle".P2Request,
	           ManualRequest := ("DB_StationState".StationState = 40) AND "DB_HMI".P2_PumpCmd,
	           TestRequest := ("DB_StationState".StationState = 50) AND "DB_HMI".P2_PumpCmd,
	           FaultOK := NOT "DB_Alarms".P2FaultLatched,
	           RunFeedback := "DB_Process".P2_RunFeedback,
	           SourceOK := "DB_StationState".SourceOK,
	           EStopOK := "DB_StationState".EStopOK,
	           OtherRunning := "DB_Pump1".RunCommand,
	           RestartDelay := "DB_Parameters".Restart_Delay,
	           TestMax := "DB_Parameters".Maint_Test_Max,
	           Clock1Hz := "Clock_1Hz");
	
	"FC_WriteOutputs"();
	"FC_Indicators"();
END_ORGANIZATION_BLOCK

