FUNCTION_BLOCK "FB_ModeManager"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      StartReq : Bool;
      StopReq : Bool;
      CriticalFault : Bool;
      SelAuto : Bool;
      SelManual : Bool;
      SelMaint : Bool;
      InitDelay : Time;
   END_VAR

   VAR_OUTPUT 
      State : Int := 0;
   END_VAR

   VAR 
      rStart : R_TRIG;
      rStop : R_TRIG;
      tInit : TON_TIME;
   END_VAR

   VAR_TEMP 
      onlyAuto : Bool;
      onlyManual : Bool;
      onlyMaint : Bool;
   END_VAR

BEGIN
    // States: 0 stopped, 10 initializing, 20 ready, 30 auto, 40 manual, 50 maintenance, 90 fault
    #rStart(CLK := #StartReq);
    #rStop(CLK := #StopReq);
    #tInit(IN := (#State = 10), PT := #InitDelay);

    // A mode counts only when it is the single selected position.
    #onlyAuto := #SelAuto AND NOT #SelManual AND NOT #SelMaint;
    #onlyManual := #SelManual AND NOT #SelAuto AND NOT #SelMaint;
    #onlyMaint := #SelMaint AND NOT #SelAuto AND NOT #SelManual;

    IF #CriticalFault THEN
        #State := 90;
    ELSE
        CASE #State OF
            0:
                IF #rStart.Q THEN
                    #State := 10;
                END_IF;
            10:
                IF #tInit.Q THEN
                    #State := 20;
                END_IF;
            20:
                IF #rStop.Q THEN
                    #State := 0;
                ELSIF #onlyAuto THEN
                    #State := 30;
                ELSIF #onlyManual THEN
                    #State := 40;
                ELSIF #onlyMaint THEN
                    #State := 50;
                END_IF;
            30:
                IF #rStop.Q THEN
                    #State := 0;
                ELSIF NOT #onlyAuto THEN
                    #State := 20;
                END_IF;
            40:
                IF #rStop.Q THEN
                    #State := 0;
                ELSIF NOT #onlyManual THEN
                    #State := 20;
                END_IF;
            50:
                IF #rStop.Q THEN
                    #State := 0;
                ELSIF NOT #onlyMaint THEN
                    #State := 20;
                END_IF;
            90:
                // Faults are cleared: back to stopped, a new start request is required.
                #State := 0;
        ELSE
            #State := 0;
        END_CASE;
    END_IF;
END_FUNCTION_BLOCK