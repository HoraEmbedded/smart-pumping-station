FUNCTION "FC_SimulationModel" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_TEMP 
      qIn : Real;
      qOut : Real;
      dLevel : Real;
      p1Pumping : Bool;
      p2Pumping : Bool;
   END_VAR

BEGIN
    // Called every 100 ms. Euler step: level += dt * 100 * (Qin - Qout) / (3600 * V)
    IF "DB_Sim".Sim_Reset THEN
        "DB_Sim".TankLevel_pct := 50.0;
        "DB_Sim".SourceLevel_pct := 80.0;
        "DB_Sim".Sim_Reset := FALSE;
    END_IF;

    // An injected fault keeps the contactor from closing: no feedback, no pumping.
    "DB_Sim".P1_RunFeedback := "DB_Pump1".RunCommand AND NOT "DB_Sim".Inject_P1_NoFeedback;
    "DB_Sim".P2_RunFeedback := "DB_Pump2".RunCommand AND NOT "DB_Sim".Inject_P2_NoFeedback;

    // A blocked line gives no flow although the motor runs.
    #p1Pumping := "DB_Sim".P1_RunFeedback AND NOT "DB_Sim".Inject_P1_LowFlow;
    #p2Pumping := "DB_Sim".P2_RunFeedback AND NOT "DB_Sim".Inject_P2_LowFlow;

    #qIn := 0.0;
    IF (#p1Pumping OR #p2Pumping) AND ("DB_Sim".SourceLevel_pct > 0.0) THEN
        #qIn := "DB_Parameters".Pump_Flow;
    END_IF;
    #qOut := 0.0;
    IF "DB_Sim".Drain_Enable THEN
        #qOut := "DB_Parameters".Drain_Flow;
    END_IF;

    IF "DB_Sim".Sim_Enable AND "DB_Sim".Sim_Run THEN
        "DB_IIoTExport".SimTime_s := "DB_IIoTExport".SimTime_s + REAL_TO_LREAL("DB_Parameters".Sim_Step * "DB_Parameters".Time_Accel);
        #dLevel := "DB_Parameters".Sim_Step * "DB_Parameters".Time_Accel * 100.0
                   * (#qIn - #qOut) / (3600.0 * "DB_Parameters".Tank_Volume);
        "DB_Sim".TankLevel_pct := LIMIT(MN := 0.0, IN := "DB_Sim".TankLevel_pct + #dLevel, MX := 100.0);
    END_IF;

    "DB_Sim".Flow_m3h := #qIn;
    IF #qIn > 0.0 THEN
        "DB_Sim".Pressure_bar := "DB_Sim".Pressure_Run_bar;
    ELSE
        "DB_Sim".Pressure_bar := 0.0;
    END_IF;

    IF "DB_Sim".P1_RunFeedback THEN
        IF "DB_Sim".Inject_P1_HighCurrent THEN
            "DB_Sim".P1_Current_A := "DB_Parameters".Current_Nominal * "DB_Parameters".Sim_HighCurrent_Factor;
        ELSE
            "DB_Sim".P1_Current_A := "DB_Parameters".Current_Nominal;
        END_IF;
    ELSE
        "DB_Sim".P1_Current_A := 0.0;
    END_IF;
    IF "DB_Sim".P2_RunFeedback THEN
        IF "DB_Sim".Inject_P2_HighCurrent THEN
            "DB_Sim".P2_Current_A := "DB_Parameters".Current_Nominal * "DB_Parameters".Sim_HighCurrent_Factor;
        ELSE
            "DB_Sim".P2_Current_A := "DB_Parameters".Current_Nominal;
        END_IF;
    ELSE
        "DB_Sim".P2_Current_A := 0.0;
    END_IF;
END_FUNCTION