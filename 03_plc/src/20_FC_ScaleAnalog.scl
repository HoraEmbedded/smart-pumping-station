FUNCTION "FC_ScaleAnalog" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Raw : Int;
      EngMin : Real;
      EngMax : Real;
      LowLimit : Int;
      HighLimit : Int;
   END_VAR

   VAR_OUTPUT 
      Value : Real;
      Valid : Bool;
   END_VAR

BEGIN
    // 4-20 mA input, raw range 0 to 27648. Outside the limits: wire break or over-range.
    #Valid := (#Raw >= #LowLimit) AND (#Raw <= #HighLimit);
    IF #Valid THEN
        #Value := #EngMin + (INT_TO_REAL(#Raw) / 27648.0) * (#EngMax - #EngMin);
    ELSE
        #Value := #EngMin;
    END_IF;
END_FUNCTION