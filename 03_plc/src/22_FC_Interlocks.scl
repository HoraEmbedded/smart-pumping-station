FUNCTION "FC_Interlocks" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
BEGIN
        "DB_Alarms".ResetRequest := "DI_Reset_Alarm" OR "DB_HMI".Cmd_Reset;
    // Normally closed E-stop contact: FALSE means stop, a cut wire gives the same result.
    "DB_StationState".EStopOK := "DI_EStop_Sim";
    "DB_Alarms".EStopCause := NOT "DI_EStop_Sim";

    "DB_Alarms".TankSensorCause := NOT "DB_Process".TankLevel_Valid;
    "DB_Alarms".LevelCritCause := "DB_Process".TankLevel_Valid
                                  AND ("DB_Process".TankLevel_pct > "DB_Parameters".Level_CritHigh);

    // Pump protection contacts are normally closed: FALSE means fault.
    // A run command without feedback counts as a pump fault.
    "DB_Alarms".P1FaultCause := NOT "DI_P1_Fault" OR "DB_Pump1".NoFeedbackFault;
    "DB_Alarms".P2FaultCause := NOT "DI_P2_Fault" OR "DB_Pump2".NoFeedbackFault;
    "DB_Alarms".P1LowFlowCause := "DB_Pump1".LowFlowFault;
    "DB_Alarms".P2LowFlowCause := "DB_Pump2".LowFlowFault;

    // Stays active after a trip while both protection contacts are still open.
    "DB_Alarms".NoPumpCause := "DB_AutoCycle".NoPumpAvailable
        OR ("DB_Alarms".NoPumpLatched AND "DB_Alarms".P1FaultCause AND "DB_Alarms".P2FaultCause);

    // Source availability with hysteresis, so it does not chatter around the minimum.
    IF "DI_Source_Low" OR NOT "DB_Process".SourceLevel_Valid
       OR ("DB_Process".SourceLevel_pct < "DB_Parameters".Source_Min) THEN
        "DB_StationState".SourceOK := FALSE;
    ELSIF "DB_Process".SourceLevel_pct >= "DB_Parameters".Source_Min + "DB_Parameters".Source_Hyst_pct THEN
        "DB_StationState".SourceOK := TRUE;
    END_IF;
    "DB_Alarms".SourceLowActive := NOT "DB_StationState".SourceOK;
END_FUNCTION