FUNCTION "FC_Interlocks" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
BEGIN
	// IL-01: simulated E-stop, NC contact, FALSE means stop.
	// Latching in FAULT and ALM_001 are added in Mission 6.
	"DB_StationState".EStopOK := "DI_EStop_Sim";

	// IL-02: source availability with hysteresis (P04 and P26).
	IF "DI_Source_Low" OR NOT "DB_Process".SourceLevel_Valid
	   OR ("DB_Process".SourceLevel_pct < "DB_Parameters".Source_Min) THEN
	    "DB_StationState".SourceOK := FALSE;
	ELSIF NOT "DI_Source_Low" AND "DB_Process".SourceLevel_Valid
	   AND ("DB_Process".SourceLevel_pct >= "DB_Parameters".Source_Min + "DB_Parameters".Source_Hyst_pct) THEN
	    "DB_StationState".SourceOK := TRUE;
	END_IF;
END_FUNCTION